{
  "pv": {
    "name": "Trace Ingestion",
    "version": "1.0.0",
    "markdown": ".principal-views/trace-ingestion/README.md",
    "edgeTypes": {
      "flow": {
        "color": "#666666",
        "label": "then"
      },
      "error": {
        "color": "#f44336",
        "label": "on error"
      }
    }
  },
  "nodes": [
    {
      "id": "trace-received",
      "x": 100,
      "y": 50,
      "width": 200,
      "height": 100,
      "color": "#4CAF50",
      "type": "otel-event",
      "label": "Trace Received",
      "event": {
        "name": "trace.received",
        "attributes": {
          "trace.id": {
            "type": "string",
            "description": "The trace ID from OTLP data",
            "required": true
          },
          "spans.count": {
            "type": "integer",
            "description": "Number of spans in the request",
            "required": true
          },
          "resource.spans.count": {
            "type": "integer",
            "description": "Number of resource spans",
            "required": true
          }
        }
      },
      "otel": {
        "status": "draft",
        "references": [
          "src/bun/index.ts:1602"
        ]
      }
    },
    {
      "id": "spans-stored",
      "x": 100,
      "y": 200,
      "width": 200,
      "height": 100,
      "color": "#2196F3",
      "type": "otel-event",
      "label": "Spans Stored",
      "event": {
        "name": "trace.spans.stored",
        "attributes": {
          "trace.id": {
            "type": "string",
            "description": "The trace ID",
            "required": true
          },
          "spans.stored": {
            "type": "integer",
            "description": "Number of spans stored in database",
            "required": true
          },
          "service.name": {
            "type": "string",
            "description": "Primary service name from the trace",
            "required": false
          }
        }
      },
      "otel": {
        "status": "draft",
        "references": [
          "src/bun/index.ts:1519"
        ]
      }
    },
    {
      "id": "orchestrator-started",
      "x": 100,
      "y": 350,
      "width": 200,
      "height": 100,
      "color": "#9C27B0",
      "type": "otel-event",
      "label": "Orchestrator Started",
      "event": {
        "name": "trace.orchestrator.started",
        "attributes": {
          "trace.id": {
            "type": "string",
            "description": "The trace ID being processed",
            "required": true
          },
          "registry.scopes.count": {
            "type": "integer",
            "description": "Number of registered scopes",
            "required": true
          }
        }
      },
      "otel": {
        "status": "draft",
        "references": [
          "src/bun/index.ts:1324"
        ]
      }
    },
    {
      "id": "orchestrator-completed",
      "x": 100,
      "y": 500,
      "width": 200,
      "height": 100,
      "color": "#4CAF50",
      "type": "otel-event",
      "label": "Orchestrator Completed",
      "event": {
        "name": "trace.orchestrator.completed",
        "attributes": {
          "trace.id": {
            "type": "string",
            "description": "The trace ID",
            "required": true
          },
          "scenario.matches": {
            "type": "integer",
            "description": "Number of scenario matches",
            "required": true
          },
          "storyboard.matches": {
            "type": "integer",
            "description": "Number of storyboard matches",
            "required": true
          },
          "unmatched.spans": {
            "type": "integer",
            "description": "Number of unmatched spans",
            "required": true
          },
          "has.errors": {
            "type": "boolean",
            "description": "Whether trace contains errors",
            "required": true
          }
        }
      },
      "otel": {
        "status": "draft",
        "references": [
          "src/bun/index.ts:1330"
        ]
      }
    },
    {
      "id": "orchestrator-skipped",
      "x": 400,
      "y": 250,
      "width": 200,
      "height": 100,
      "color": "#9E9E9E",
      "type": "otel-event",
      "label": "Orchestrator Skipped",
      "event": {
        "name": "trace.orchestrator.skipped",
        "attributes": {
          "trace.id": {
            "type": "string",
            "description": "The trace ID",
            "required": true
          },
          "reason": {
            "type": "string",
            "description": "Reason orchestrator was skipped (no_registry, no_scopes, not_initialized)",
            "required": true
          }
        }
      },
      "otel": {
        "status": "draft",
        "references": [
          "src/bun/index.ts:1294"
        ]
      }
    },
    {
      "id": "orchestrator-error",
      "x": 400,
      "y": 450,
      "width": 200,
      "height": 100,
      "color": "#f44336",
      "type": "otel-event",
      "label": "Orchestrator Error",
      "event": {
        "name": "trace.orchestrator.error",
        "attributes": {
          "trace.id": {
            "type": "string",
            "description": "The trace ID",
            "required": true
          },
          "error.type": {
            "type": "string",
            "description": "Type of error",
            "required": true
          },
          "error.message": {
            "type": "string",
            "description": "Error message",
            "required": true
          }
        }
      },
      "otel": {
        "status": "draft",
        "references": [
          "src/bun/index.ts:1437"
        ]
      }
    },
    {
      "id": "metrics-ingested",
      "x": 100,
      "y": 650,
      "width": 200,
      "height": 100,
      "color": "#FF9800",
      "type": "otel-event",
      "label": "Metrics Ingested",
      "event": {
        "name": "trace.metrics.ingested",
        "attributes": {
          "trace.id": {
            "type": "string",
            "description": "The trace ID",
            "required": true
          },
          "events.ingested": {
            "type": "integer",
            "description": "Number of events ingested",
            "required": true
          },
          "metrics.updated": {
            "type": "integer",
            "description": "Number of metrics updated",
            "required": true
          },
          "dashboards.affected": {
            "type": "integer",
            "description": "Number of dashboards affected",
            "required": true
          }
        }
      },
      "otel": {
        "status": "draft",
        "references": [
          "src/bun/index.ts:1432"
        ]
      }
    },
    {
      "id": "ingestion-complete",
      "x": 100,
      "y": 800,
      "width": 200,
      "height": 100,
      "color": "#4CAF50",
      "type": "otel-event",
      "label": "Ingestion Complete",
      "event": {
        "name": "trace.ingestion.complete",
        "attributes": {
          "trace.id": {
            "type": "string",
            "description": "The trace ID",
            "required": true
          },
          "total.spans": {
            "type": "integer",
            "description": "Total spans processed",
            "required": true
          },
          "matched": {
            "type": "boolean",
            "description": "Whether trace was matched to workflows",
            "required": true
          },
          "duration.ms": {
            "type": "number",
            "description": "Total processing duration in ms",
            "required": true
          }
        }
      },
      "otel": {
        "status": "draft",
        "references": [
          "src/bun/index.ts:1637"
        ]
      }
    }
  ],
  "edges": [
    {
      "id": "received-to-stored",
      "fromNode": "trace-received",
      "fromSide": "bottom",
      "toNode": "spans-stored",
      "toSide": "top",
      "pv": {
        "edgeType": "flow"
      }
    },
    {
      "id": "stored-to-orchestrator",
      "fromNode": "spans-stored",
      "fromSide": "bottom",
      "toNode": "orchestrator-started",
      "toSide": "top",
      "pv": {
        "edgeType": "flow"
      }
    },
    {
      "id": "stored-to-skipped",
      "fromNode": "spans-stored",
      "fromSide": "right",
      "toNode": "orchestrator-skipped",
      "toSide": "left",
      "pv": {
        "edgeType": "flow"
      }
    },
    {
      "id": "orchestrator-to-completed",
      "fromNode": "orchestrator-started",
      "fromSide": "bottom",
      "toNode": "orchestrator-completed",
      "toSide": "top",
      "pv": {
        "edgeType": "flow"
      }
    },
    {
      "id": "orchestrator-to-error",
      "fromNode": "orchestrator-started",
      "fromSide": "right",
      "toNode": "orchestrator-error",
      "toSide": "left",
      "pv": {
        "edgeType": "error"
      }
    },
    {
      "id": "completed-to-metrics",
      "fromNode": "orchestrator-completed",
      "fromSide": "bottom",
      "toNode": "metrics-ingested",
      "toSide": "top",
      "pv": {
        "edgeType": "flow"
      }
    },
    {
      "id": "metrics-to-complete",
      "fromNode": "metrics-ingested",
      "fromSide": "bottom",
      "toNode": "ingestion-complete",
      "toSide": "top",
      "pv": {
        "edgeType": "flow"
      }
    },
    {
      "id": "skipped-to-complete",
      "fromNode": "orchestrator-skipped",
      "fromSide": "bottom",
      "toNode": "ingestion-complete",
      "toSide": "right",
      "pv": {
        "edgeType": "flow"
      }
    }
  ]
}
