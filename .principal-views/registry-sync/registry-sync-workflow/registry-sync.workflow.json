{
  "name": "Registry Sync",
  "description": "Workspace registration and removal for trace matching",
  "version": "1.0.0",
  "canvas": ".principal-views/registry-sync/registry-sync.otel.canvas",
  "spanPattern": "http.server POST /api/registry/sync",
  "scenarios": [
    {
      "id": "update-success",
      "description": "Workspace registered with scopes and dashboards",
      "priority": 1,
      "template": {
        "summary": "[SUCCESS] Registered workspace {{workspace.id}} with {{scopes.registered}} scopes in {{duration.ms}}ms",
        "events": {
          "registry.sync.started": "Sync started for workspace {{workspace.id}} ({{action}}) at {{workspace.path}}",
          "registry.workspace.registered": "Registered {{workspace.id}} with {{scopes.count}} scopes ({{scopes.names}}), {{files.count}} files",
          "registry.dashboards.loaded": "Loaded {{dashboards.count}} dashboards with {{metrics.count}} metrics for {{workspace.id}}",
          "registry.sync.completed": "Sync completed for {{workspace.id}} ({{action}}): {{scopes.registered}} scopes in {{duration.ms}}ms"
        }
      }
    },
    {
      "id": "remove-success",
      "description": "Workspace removed successfully",
      "priority": 2,
      "template": {
        "summary": "[SUCCESS] Removed workspace {{workspace.id}}",
        "events": {
          "registry.sync.started": "Sync started for workspace {{workspace.id}} ({{action}}) at {{workspace.path}}",
          "registry.workspace.removed": "Removed workspace {{workspace.id}}",
          "registry.sync.completed": "Sync completed for {{workspace.id}} ({{action}}): {{scopes.registered}} scopes in {{duration.ms}}ms"
        }
      }
    },
    {
      "id": "registration-error",
      "description": "Workspace registration failed",
      "priority": 3,
      "template": {
        "summary": "[ERROR] Failed to register workspace {{workspace.id}}: {{error.message}}",
        "events": {
          "registry.sync.started": "Sync started for workspace {{workspace.id}} ({{action}}) at {{workspace.path}}",
          "registry.workspace.registered": "Registered {{workspace.id}} with {{scopes.count}} scopes",
          "registry.sync.error": "[{{error.type}}] Sync failed for {{workspace.id}}: {{error.message}}"
        }
      }
    }
  ]
}
