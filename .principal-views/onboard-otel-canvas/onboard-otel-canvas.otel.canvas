{
  "pv": {
    "name": "Onboard OTEL Canvas",
    "version": "1.0.0",
    "markdown": ".principal-views/onboard-otel-canvas/README.md",
    "edgeTypes": {
      "flow": {
        "color": "#666666",
        "label": "leads to"
      },
      "error": {
        "color": "#f44336",
        "label": "on error"
      }
    }
  },
  "nodes": [
    {
      "id": "onboard-started",
      "x": 100,
      "y": 50,
      "width": 200,
      "height": 100,
      "color": "#4CAF50",
      "type": "otel-event",
      "label": "Onboarding Started",
      "description": "Skill execution begins",
      "event": {
        "name": "onboard.started",
        "attributes": {
          "skill.name": {
            "type": "string",
            "description": "Name of the skill being executed",
            "required": true
          },
          "session.id": {
            "type": "string",
            "description": "Unique session identifier",
            "required": true
          },
          "project.root": {
            "type": "string",
            "description": "Root path of the project being onboarded",
            "required": true
          }
        }
      },
      "otel": {
        "status": "draft",
        "references": [
          ".agents/skills/onboard-otel-canvas/SKILL.md"
        ]
      }
    },
    {
      "id": "discovery-complete",
      "x": 100,
      "y": 250,
      "width": 200,
      "height": 100,
      "color": "#2196F3",
      "type": "otel-event",
      "label": "Discovery Complete",
      "description": "Feature candidates found",
      "event": {
        "name": "onboard.discovery.complete",
        "attributes": {
          "candidates.count": {
            "type": "integer",
            "description": "Number of feature candidates discovered",
            "required": true
          },
          "candidates.types": {
            "type": "string[]",
            "description": "Types of candidates found (api, cli, service, etc)",
            "required": false
          },
          "exploration.duration.ms": {
            "type": "integer",
            "description": "Time spent exploring codebase in milliseconds",
            "required": false
          }
        }
      },
      "otel": {
        "status": "draft",
        "references": [
          ".agents/skills/onboard-otel-canvas/SKILL.md"
        ]
      }
    },
    {
      "id": "discovery-error",
      "x": 400,
      "y": 250,
      "width": 200,
      "height": 100,
      "color": "#f44336",
      "type": "otel-event",
      "label": "Discovery Error",
      "description": "Failed to explore codebase",
      "event": {
        "name": "onboard.discovery.error",
        "attributes": {
          "error.type": {
            "type": "string",
            "description": "Type of error",
            "required": true
          },
          "error.message": {
            "type": "string",
            "description": "Human-readable error message",
            "required": true
          }
        }
      },
      "otel": {
        "status": "draft",
        "references": [
          ".agents/skills/onboard-otel-canvas/SKILL.md"
        ]
      }
    },
    {
      "id": "feature-selected",
      "x": 100,
      "y": 450,
      "width": 200,
      "height": 100,
      "color": "#9C27B0",
      "type": "otel-event",
      "label": "Feature Selected",
      "description": "User chose feature to document",
      "event": {
        "name": "onboard.feature.selected",
        "attributes": {
          "feature.name": {
            "type": "string",
            "description": "Name of the selected feature",
            "required": true
          },
          "feature.type": {
            "type": "string",
            "description": "Type of feature (api, cli, service, pipeline)",
            "required": true
          },
          "feature.files": {
            "type": "string[]",
            "description": "Source files for the feature",
            "required": true
          },
          "workflow.count": {
            "type": "integer",
            "description": "Number of workflows to create",
            "required": true
          }
        }
      },
      "otel": {
        "status": "draft",
        "references": [
          ".agents/skills/onboard-otel-canvas/SKILL.md"
        ]
      }
    },
    {
      "id": "canvas-created",
      "x": 100,
      "y": 650,
      "width": 200,
      "height": 100,
      "color": "#FF9800",
      "type": "otel-event",
      "label": "Canvas Created",
      "description": "OTEL canvas file written",
      "event": {
        "name": "onboard.canvas.created",
        "attributes": {
          "canvas.path": {
            "type": "string",
            "description": "Path to the created canvas file",
            "required": true
          },
          "events.count": {
            "type": "integer",
            "description": "Number of events defined in the canvas",
            "required": true
          },
          "nodes.count": {
            "type": "integer",
            "description": "Number of nodes in the canvas",
            "required": true
          }
        }
      },
      "otel": {
        "status": "draft",
        "references": [
          ".agents/skills/onboard-otel-canvas/SKILL.md"
        ]
      }
    },
    {
      "id": "canvas-error",
      "x": 400,
      "y": 650,
      "width": 200,
      "height": 100,
      "color": "#f44336",
      "type": "otel-event",
      "label": "Canvas Error",
      "description": "Failed to create canvas",
      "event": {
        "name": "onboard.canvas.error",
        "attributes": {
          "error.type": {
            "type": "string",
            "description": "Type of error (validation, write, schema)",
            "required": true
          },
          "error.message": {
            "type": "string",
            "description": "Human-readable error message",
            "required": true
          },
          "error.file": {
            "type": "string",
            "description": "File that caused the error",
            "required": false
          }
        }
      },
      "otel": {
        "status": "draft",
        "references": [
          ".agents/skills/onboard-otel-canvas/SKILL.md"
        ]
      }
    },
    {
      "id": "workflow-created",
      "x": 100,
      "y": 850,
      "width": 200,
      "height": 100,
      "color": "#00BCD4",
      "type": "otel-event",
      "label": "Workflow Created",
      "description": "Workflow scenarios written",
      "event": {
        "name": "onboard.workflow.created",
        "attributes": {
          "workflow.path": {
            "type": "string",
            "description": "Path to the created workflow file",
            "required": true
          },
          "workflow.spanPattern": {
            "type": "string",
            "description": "Span pattern for the workflow",
            "required": true
          },
          "scenarios.count": {
            "type": "integer",
            "description": "Number of scenarios defined",
            "required": true
          }
        }
      },
      "otel": {
        "status": "draft",
        "references": [
          ".agents/skills/onboard-otel-canvas/SKILL.md"
        ]
      }
    },
    {
      "id": "workflow-error",
      "x": 400,
      "y": 850,
      "width": 200,
      "height": 100,
      "color": "#f44336",
      "type": "otel-event",
      "label": "Workflow Error",
      "description": "Failed to create workflow",
      "event": {
        "name": "onboard.workflow.error",
        "attributes": {
          "error.type": {
            "type": "string",
            "description": "Type of error (validation, write, schema)",
            "required": true
          },
          "error.message": {
            "type": "string",
            "description": "Human-readable error message",
            "required": true
          },
          "error.file": {
            "type": "string",
            "description": "File that caused the error",
            "required": false
          }
        }
      },
      "otel": {
        "status": "draft",
        "references": [
          ".agents/skills/onboard-otel-canvas/SKILL.md"
        ]
      }
    },
    {
      "id": "onboard-complete",
      "x": 100,
      "y": 1050,
      "width": 200,
      "height": 100,
      "color": "#4CAF50",
      "type": "otel-event",
      "label": "Onboarding Complete",
      "description": "All files created successfully",
      "event": {
        "name": "onboard.complete",
        "attributes": {
          "storyboard.name": {
            "type": "string",
            "description": "Name of the created storyboard",
            "required": true
          },
          "canvas.files": {
            "type": "integer",
            "description": "Number of canvas files created",
            "required": true
          },
          "workflow.files": {
            "type": "integer",
            "description": "Number of workflow files created",
            "required": true
          },
          "duration.ms": {
            "type": "integer",
            "description": "Total onboarding duration in milliseconds",
            "required": false
          },
          "next.skill": {
            "type": "string",
            "description": "Recommended next skill (setup-otel-testing)",
            "required": true
          }
        }
      },
      "otel": {
        "status": "draft",
        "references": [
          ".agents/skills/onboard-otel-canvas/SKILL.md"
        ]
      }
    }
  ],
  "edges": [
    {
      "id": "started-to-discovery",
      "fromNode": "onboard-started",
      "fromSide": "bottom",
      "toNode": "discovery-complete",
      "toSide": "top",
      "pv": {
        "edgeType": "flow"
      }
    },
    {
      "id": "started-to-discovery-error",
      "fromNode": "onboard-started",
      "fromSide": "right",
      "toNode": "discovery-error",
      "toSide": "top",
      "pv": {
        "edgeType": "error"
      }
    },
    {
      "id": "discovery-to-selected",
      "fromNode": "discovery-complete",
      "fromSide": "bottom",
      "toNode": "feature-selected",
      "toSide": "top",
      "pv": {
        "edgeType": "flow"
      }
    },
    {
      "id": "selected-to-canvas",
      "fromNode": "feature-selected",
      "fromSide": "bottom",
      "toNode": "canvas-created",
      "toSide": "top",
      "pv": {
        "edgeType": "flow"
      }
    },
    {
      "id": "selected-to-canvas-error",
      "fromNode": "feature-selected",
      "fromSide": "right",
      "toNode": "canvas-error",
      "toSide": "top",
      "pv": {
        "edgeType": "error"
      }
    },
    {
      "id": "canvas-to-workflow",
      "fromNode": "canvas-created",
      "fromSide": "bottom",
      "toNode": "workflow-created",
      "toSide": "top",
      "pv": {
        "edgeType": "flow"
      }
    },
    {
      "id": "canvas-to-workflow-error",
      "fromNode": "canvas-created",
      "fromSide": "right",
      "toNode": "workflow-error",
      "toSide": "top",
      "pv": {
        "edgeType": "error"
      }
    },
    {
      "id": "workflow-to-complete",
      "fromNode": "workflow-created",
      "fromSide": "bottom",
      "toNode": "onboard-complete",
      "toSide": "top",
      "pv": {
        "edgeType": "flow"
      }
    }
  ]
}
